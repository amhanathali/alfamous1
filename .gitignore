# Dépendances et productions
node_modules/
dist/
.firebase/
*.log

# Secrets — jamais dans Git
.env
.env.*
*adminsdk*.json
key*.json
client_secret*.json
service-account*.json

# Traductions tanzil.net (téléchargées localement, jamais versionnées)
donnees/traductions/*.txt
donnees/traductions/*.xml

# Divers
.DS_Store
Thumbs.db
desktop.ini

# Données à importer dans Firestore (commentaires, lexique) : jamais dans Git
import/

# Émulateurs Firebase : données locales d'essai (comptes, commentaires) et journaux
.emulateurs/
*-debug.log

# Exports automatiques des émulateurs (à l'arrêt) et anciennes copies de fichiers
firebase-export-*/
*.ancien.json
