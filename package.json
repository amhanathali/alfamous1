{
  "name": "alfamous1",
  "version": "0.1.0",
  "private": true,
  "description": "Alfamous1 — l'atelier du codex",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "convertir": "node scripts/convertir-classeur.mjs",
    "traductions": "node scripts/telecharger-traductions.mjs",
    "construire": "node scripts/construire.mjs",
    "servir": "node scripts/servir.mjs",
    "servir:dist": "node scripts/servir.mjs --dist",
    "emulateurs": "node scripts/emulateurs.mjs",
    "emulateurs:peupler": "node scripts/peupler-emulateurs.mjs",
    "test:regles": "firebase emulators:exec --project demo-alfamous1 --only auth,firestore,storage \"node --test --test-concurrency=1 tests/regles/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0"
  }
}
