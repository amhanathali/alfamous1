{"sourate":101,"versets":{"1":[["al-qāriʿatu","قرع","ٱلْقَارِعَةُ","le Choc (de la fin du monde)!"]],"2":[["mā","ما","مَا","Qu'est-ce donc que"],["al-qāriʿatu","قرع","ٱلْقَارِعَةُ","le Choc (de la fin du monde)?"]],"3":[["wamā","ما","وَمَآ","Et qui"],["adrāka","دري","أَدْرَىٰكَ","t'enseignera"],["mā","ما","مَا","ce qu'est"],["al-qāriʿatu","قرع","ٱلْقَارِعَةُ","le Choc (de la fin du monde)?"]],"4":[["yawma","يوم","يَوْمَ","(Le) jour (où)"],["yakūnu","كون","يَكُونُ","seront"],["an-nāsu","نوس","ٱلنَّاسُ","les gens"],["ka-l-farāši","فرش","كَٱلْفَرَاشِ","comme des papillons de nuit"],["al-mabṯūṯi","بثث","ٱلْمَبْثُوثِ","dispersés."]],"5":[["watakūnu","كون","وَتَكُونُ","Et que seront"],["al-ǧibālu","جبل","ٱلْجِبَالُ","les montagnes"],["ka-l-ʿihni","عهن","كَٱلْعِهْنِ","comme de la laine"],["al-manfūši","نفش","ٱلْمَنفُوشِ","hérissée."]],"6":[["faʾammā","أما","فَأَمَّا","Alors quant à"],["man","أم","مَن","celui (dont)"],["ṯaqulat","ثقل","ثَقُلَتْ","est lourde"],["mawāzīnuhū","وزن","مَوَٰزِينُهُۥ","sa pesée"]],"7":[["fahuwa","هو","فَهُوَ","il (sera) alors"],["fī","في","فِى","dans"],["ʿīšatin","عيش","عِيشَةٍ","un mode de vie (éternel)"],["rāḍiyatin","رضو","رَّاضِيَةٍ","aisé et réjouissant."]],"8":[["waʾammā","أما","وَأَمَّا","Et quant à"],["man","أم","مَنْ","celui (dont)"],["ḫaffat","خفف","خَفَّتْ","est legère"],["mawāzīnuhū","وزن","مَوَٰزِينُهُۥ","sa pesée"]],"9":[["faʾummuhū","أمم","فَأُمُّهُۥ","alors sa demeure (sera)"],["hāwiyatun","هوي","هَاوِيَةٌ","une abîme."]],"10":[["wamā","ما","وَمَآ","Et qui"],["adrāka","دري","أَدْرَىٰكَ","t'enseignera"],["mā","ما","مَا","ce qu'"],["hiyah","هو","هِيَهْ","elle est (cette demeure)?"]],"11":[["nārun","نور","نَارٌ","(Il s'agit d') Un brasier"],["ḥāmiyatun","حمي","حَامِيَةٌۢ","intensément chaud!"]]}}
