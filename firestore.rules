rules_version = '2';

// Tout est fermé par défaut ; chaque collection est ouverte explicitement et testée
// avec l'émulateur (tests/regles/). Droits : docs/DROITS.md ; modèle : docs/MODELE-DONNEES.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Niveaux (docs/DROITS.md) ----------
    // 0 = visiteur ou courriel non vérifié ; 1 = inscrit vérifié (par défaut) ;
    // 2 = modérateur, 3 = admin : revendication « niveau » posée côté serveur, jamais par le client.
    function niveau() {
      return request.auth == null || request.auth.token.email_verified != true
        ? 0
        : request.auth.token.get('niveau', 1);
    }
    function moi() { return request.auth.uid; }
    // Le nom affiché vient du compte (jeton), pas du formulaire.
    function monNom() { return request.auth.token.get('name', ''); }

    function texteValide(t) { return t is string && t.size() >= 1 && t.size() <= 4000; }
    function cibleValide(d) {
      return (d.type == 'verset' && d.cle is string && d.cle.matches('^[0-9]{1,3}:[0-9]{1,3}$'))
        || (d.type == 'lexique' && d.cle is string && d.cle.size() >= 1 && d.cle.size() <= 200)
        // Article : on ne commente qu'un article publié (cle = identifiant de l'article).
        || (d.type == 'article' && d.cle is string && d.cle.matches('^[A-Za-z0-9_-]{1,64}$')
            && get(/databases/$(database)/documents/articles/$(d.cle)).data.statut == 'publie');
    }
    function changes(cles) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(cles.toSet());
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Limite de fréquence (docs/DROITS.md) ----------
    // 20 publications par heure et par membre (commentaires, notes, réponses, signalements) ;
    // modérateurs et admin exemptés. Chaque publication met à jour limites/{uid} dans le même lot.
    function limiteOk() {
      return niveau() >= 2
        || getAfter(/databases/$(database)/documents/limites/$(request.auth.uid)).data.dernier == request.time;
    }
    match /limites/{uid} {
      function nouvelleFenetre() {
        return request.resource.data.keys().hasOnly(['debut', 'n', 'dernier'])
          && request.resource.data.debut == request.time
          && request.resource.data.n == 1
          && request.resource.data.dernier == request.time;
      }
      function memeFenetre() {
        return request.resource.data.keys().hasOnly(['debut', 'n', 'dernier'])
          && resource.data.debut > request.time - duration.value(1, 'h')
          && request.resource.data.debut == resource.data.debut
          && request.resource.data.n == resource.data.n + 1
          && request.resource.data.n <= 20
          && request.resource.data.dernier == request.time;
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if niveau() >= 1 && uid == moi() && nouvelleFenetre();
      allow update: if niveau() >= 1 && uid == moi()
        && ((resource.data.debut <= request.time - duration.value(1, 'h') && nouvelleFenetre()) || memeFenetre());
    }

    // ---------- Historique des recherches (phase 3) ----------
    // Document privé : lu et écrit par son seul titulaire (tout compte connecté, même au courriel non vérifié),
    // pour retrouver ses recherches sur toutes ses machines. 50 recherches au plus.
    match /historiques/{uid} {
      function historiqueValide() {
        return request.resource.data.keys().hasOnly(['recherches', 'majLe'])
          && request.resource.data.recherches is list
          && request.resource.data.recherches.size() <= 50
          && request.resource.data.majLe == request.time;
      }
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && historiqueValide();
    }

    // ---------- Commentaires Alfamous (versets et lexique) ----------
    match /commentaires/{id} {
      // Lecture publique. Un commentaire masqué a un texte vide : l'original est dans prive/texte.
      allow read: if true;

      // Écrire : niveau ≥ 1, publié tout de suite, signé du nom du compte.
      allow create: if niveau() >= 1
        && monNom().size() > 0
        && request.resource.data.keys().hasOnly(
             ['type', 'cle', 'auteurUid', 'auteurNom', 'texte', 'creeLe', 'modifieLe', 'nbVersions', 'masque'])
        && request.resource.data.keys().hasAll(
             ['type', 'cle', 'auteurUid', 'auteurNom', 'texte', 'creeLe', 'modifieLe', 'nbVersions', 'masque'])
        && cibleValide(request.resource.data)
        && request.resource.data.auteurUid == moi()
        && request.resource.data.auteurNom == monNom()
        && texteValide(request.resource.data.texte)
        && request.resource.data.creeLe == request.time
        && request.resource.data.modifieLe == null
        && request.resource.data.nbVersions == 1
        && request.resource.data.masque == null
        && limiteOk();

      // Modifier son commentaire (s'il n'est pas masqué) ; l'ancienne version est écrite
      // dans le même lot (versions/{n}), sinon refus.
      function modificationParAuteur() {
        return niveau() >= 1
          && resource.data.auteurUid == moi()
          && resource.data.masque == null
          && changes(['texte', 'modifieLe', 'nbVersions'])
          && texteValide(request.resource.data.texte)
          && request.resource.data.modifieLe == request.time
          && request.resource.data.nbVersions == resource.data.nbVersions + 1
          && existsAfter(/databases/$(database)/documents/commentaires/$(id)/versions/$(string(resource.data.nbVersions)));
      }
      // Masquer (niveau ≥ 2) : texte vidé, original déplacé dans prive/texte dans le même lot.
      function masquage() {
        return niveau() >= 2
          && resource.data.masque == null
          && changes(['masque', 'texte'])
          && request.resource.data.texte == ''
          && request.resource.data.masque.keys().hasOnly(['par', 'parNom', 'le'])
          && request.resource.data.masque.par == moi()
          && request.resource.data.masque.parNom == monNom()
          && request.resource.data.masque.le == request.time
          && getAfter(/databases/$(database)/documents/commentaires/$(id)/prive/texte).data.texte == resource.data.texte;
      }
      // Démasquer (niveau ≥ 2) : texte remis tel quel, prive/texte supprimé dans le même lot.
      function demasquage() {
        return niveau() >= 2
          && resource.data.masque != null
          && changes(['masque', 'texte'])
          && request.resource.data.masque == null
          && request.resource.data.texte == get(/databases/$(database)/documents/commentaires/$(id)/prive/texte).data.texte
          && !existsAfter(/databases/$(database)/documents/commentaires/$(id)/prive/texte);
      }

      allow update: if modificationParAuteur() || masquage() || demasquage();

      // Supprimer définitivement : admin seulement (l'auteur ne supprime pas son contenu publié).
      allow delete: if niveau() >= 3;

      function com() { return get(/databases/$(database)/documents/commentaires/$(id)).data; }
      function comApres() { return getAfter(/databases/$(database)/documents/commentaires/$(id)).data; }

      // Historique : versions/{n} = texte de la version n (1 = première), jamais modifié.
      match /versions/{n} {
        allow read: if com().masque == null || niveau() >= 2;
        allow create: if niveau() >= 1
          && com().auteurUid == moi()
          && com().masque == null
          && n == string(com().nbVersions)
          && comApres().nbVersions == com().nbVersions + 1
          && request.resource.data.keys().hasOnly(['texte', 'le'])
          && request.resource.data.texte == com().texte
          && request.resource.data.le == (com().modifieLe != null ? com().modifieLe : com().creeLe);
        allow delete: if niveau() >= 3;
      }

      // Texte d'un commentaire masqué : modérateurs et admin seulement.
      match /prive/{doc} {
        allow read: if niveau() >= 2;
        allow create: if niveau() >= 2
          && doc == 'texte'
          && com().masque == null
          && comApres().masque != null
          && request.resource.data.keys().hasOnly(['texte'])
          && request.resource.data.texte == com().texte;
        allow delete: if (niveau() >= 2 && doc == 'texte' && comApres().masque == null)
          || niveau() >= 3;
      }

      // Signalements : un par membre et par commentaire ; lus par les modérateurs.
      match /signalements/{uid} {
        allow read: if niveau() >= 2;
        allow create: if niveau() >= 1
          && uid == moi()
          && com().auteurUid != moi()
          && request.resource.data.keys().hasOnly(['motif', 'le'])
          && request.resource.data.motif is string
          && request.resource.data.motif.size() <= 500
          && request.resource.data.le == request.time
          && limiteOk();
        allow delete: if niveau() >= 2;
      }
    }

    // ---------- Témoignages (onglet Témoignages, docs/MODELE-DONNEES.md) ----------
    // Publiés tout de suite par un membre (niveau ≥ 1), lus par tous. « Masquer mon nom » (anonyme) : le document
    // public ne porte ni le compte ni le nom ; l'auteur réel est dans prive/auteur, lu par lui seul et par l'admin.
    // C'est prive/auteur qui donne le droit de modifier (même pour un témoignage anonyme).
    match /temoignages/{id} {
      function tem() { return get(/databases/$(database)/documents/temoignages/$(id)).data; }
      function temApres() { return getAfter(/databases/$(database)/documents/temoignages/$(id)).data; }
      function auteurTem() { return get(/databases/$(database)/documents/temoignages/$(id)/prive/auteur).data.auteurUid; }
      function contenuTemValide(d) {
        return d.titre is string && d.titre.size() >= 1 && d.titre.size() <= 200
          && d.texte is string && d.texte.size() >= 40 && d.texte.size() <= 20000;
      }
      function identiteTemValide(d) {
        return d.anonyme is bool
          && (d.anonyme ? (d.auteurUid == null && d.auteurNom == '')
                        : (d.auteurUid == moi() && d.auteurNom == monNom()));
      }

      allow read: if true;

      allow create: if niveau() >= 1
        && monNom().size() > 0
        && request.resource.data.keys().hasOnly(
             ['titre', 'texte', 'anonyme', 'auteurUid', 'auteurNom', 'creeLe', 'modifieLe', 'nbVersions', 'masque'])
        && request.resource.data.keys().hasAll(
             ['titre', 'texte', 'anonyme', 'auteurUid', 'auteurNom', 'creeLe', 'modifieLe', 'nbVersions', 'masque'])
        && contenuTemValide(request.resource.data)
        && identiteTemValide(request.resource.data)
        && request.resource.data.creeLe == request.time
        && request.resource.data.modifieLe == null
        && request.resource.data.nbVersions == 1
        && request.resource.data.masque == null
        && getAfter(/databases/$(database)/documents/temoignages/$(id)/prive/auteur).data.auteurUid == moi()
        && limiteOk();

      // Modifier (texte, titre, case « Masquer mon nom ») : l'auteur réel, témoignage non masqué ; l'ancienne
      // version est écrite dans le même lot (versions/{n}).
      function modificationTem() {
        return niveau() >= 1
          && resource.data.masque == null
          && auteurTem() == moi()
          && changes(['titre', 'texte', 'anonyme', 'auteurUid', 'auteurNom', 'modifieLe', 'nbVersions'])
          && contenuTemValide(request.resource.data)
          && identiteTemValide(request.resource.data)
          && request.resource.data.modifieLe == request.time
          && request.resource.data.nbVersions == resource.data.nbVersions + 1
          && existsAfter(/databases/$(database)/documents/temoignages/$(id)/versions/$(string(resource.data.nbVersions)));
      }
      // Masquer (niveau ≥ 2) : titre et texte vidés, originaux dans prive/texte (même lot).
      function masquageTem() {
        return niveau() >= 2
          && resource.data.masque == null
          && changes(['masque', 'titre', 'texte'])
          && request.resource.data.titre == ''
          && request.resource.data.texte == ''
          && request.resource.data.masque.keys().hasOnly(['par', 'parNom', 'le'])
          && request.resource.data.masque.par == moi()
          && request.resource.data.masque.parNom == monNom()
          && request.resource.data.masque.le == request.time
          && getAfter(/databases/$(database)/documents/temoignages/$(id)/prive/texte).data.titre == resource.data.titre
          && getAfter(/databases/$(database)/documents/temoignages/$(id)/prive/texte).data.texte == resource.data.texte;
      }
      function demasquageTem() {
        return niveau() >= 2
          && resource.data.masque != null
          && changes(['masque', 'titre', 'texte'])
          && request.resource.data.masque == null
          && request.resource.data.titre == get(/databases/$(database)/documents/temoignages/$(id)/prive/texte).data.titre
          && request.resource.data.texte == get(/databases/$(database)/documents/temoignages/$(id)/prive/texte).data.texte
          && !existsAfter(/databases/$(database)/documents/temoignages/$(id)/prive/texte);
      }
      allow update: if modificationTem() || masquageTem() || demasquageTem();
      // Retirer (définitif) : l'admin, ou l'auteur réel d'un témoignage non masqué. L'auteur efface dans le même lot
      // prive/auteur et l'historique (versions/{n}) : rien ne reste de son témoignage.
      function retraitParAuteur() {
        return niveau() >= 1
          && tem().masque == null
          && auteurTem() == moi()
          && !existsAfter(/databases/$(database)/documents/temoignages/$(id));
      }
      allow delete: if niveau() >= 3
        || (retraitParAuteur()
            && !existsAfter(/databases/$(database)/documents/temoignages/$(id)/prive/auteur));

      // Historique : versions/{n} = { titre, texte, le } de la version n ; sans nom (anonymat gardé).
      match /versions/{n} {
        allow read: if tem().masque == null || niveau() >= 2;
        allow create: if niveau() >= 1
          && auteurTem() == moi()
          && tem().masque == null
          && n == string(tem().nbVersions)
          && temApres().nbVersions == tem().nbVersions + 1
          && request.resource.data.keys().hasOnly(['titre', 'texte', 'le'])
          && request.resource.data.titre == tem().titre
          && request.resource.data.texte == tem().texte
          && request.resource.data.le == (tem().modifieLe != null ? tem().modifieLe : tem().creeLe);
        allow delete: if niveau() >= 3 || retraitParAuteur();
      }

      // prive/auteur : { auteurUid, auteurNom }, écrit avec le témoignage (jamais ajouté à un témoignage existant) ;
      //   lu par l'auteur lui-même et par l'admin (les modérateurs ne voient pas qui se cache derrière « Anonyme »).
      // prive/texte : { titre, texte } d'un témoignage masqué, niveaux 2–3.
      match /prive/{doc} {
        allow read: if (doc == 'auteur' && (niveau() >= 3 || (request.auth != null && resource.data.auteurUid == request.auth.uid)))
          || (doc == 'texte' && niveau() >= 2);
        allow create: if (doc == 'auteur'
            && niveau() >= 1
            && request.resource.data.keys().hasOnly(['auteurUid', 'auteurNom'])
            && request.resource.data.auteurUid == moi()
            && request.resource.data.auteurNom == monNom()
            && !exists(/databases/$(database)/documents/temoignages/$(id))
            && existsAfter(/databases/$(database)/documents/temoignages/$(id)))
          || (doc == 'texte'
            && niveau() >= 2
            && tem().masque == null
            && temApres().masque != null
            && request.resource.data.keys().hasOnly(['titre', 'texte'])
            && request.resource.data.titre == tem().titre
            && request.resource.data.texte == tem().texte);
        allow delete: if (niveau() >= 2 && doc == 'texte' && temApres().masque == null)
          || (doc == 'auteur' && retraitParAuteur())
          || niveau() >= 3;
      }
    }

    // ---------- Articles (docs/ARTICLES.md, docs/MODELE-DONNEES.md) ----------
    // Rédacteurs = niveau ≥ 2. Un modérateur modifie ses propres articles ; l'admin, tous.
    // Le document articles/{id} est la partie publique (lue par tous une fois publiée) ; la version de travail
    // est privée (atelier/brouillon). Publier recopie le brouillon dans le document public et enregistre une version
    // (versions/{n}) dans le même lot ; la première publication réserve l'adresse (slugs/{slug}).
    function proprioArticle(a) { return niveau() >= 2 && (a.auteurUid == moi() || niveau() >= 3); }
    function familleValide(f) { return f in ['racines', 'critiques', 'identite', 'reflexions']; }
    function contenuArticleValide(d) {
      return d.titre is string && d.titre.size() <= 200
        && familleValide(d.famille)
        && d.libelles is list && d.libelles.size() <= 10
        && d.resume is string && d.resume.size() <= 500
        && (d.image == null || (d.image is string && d.image.size() <= 300))
        && d.corps is string && d.corps.size() <= 300000
        && d.versets is list && d.versets.size() <= 300
        && d.sourates is list && d.sourates.size() <= 114
        && d.racines is list && d.racines.size() <= 100
        && d.lexique is list && d.lexique.size() <= 100
        && d.sources is list && d.sources.size() <= 50
        && d.liens is list && d.liens.size() <= 20;
    }
    function champsArticle() {
      return ['titre', 'slug', 'famille', 'libelles', 'resume', 'image', 'corps', 'statut', 'auteurUid', 'auteurNom',
              'creeLe', 'modifieLe', 'publieLe', 'republieLe', 'versets', 'sourates', 'racines', 'lexique', 'sources',
              'liens', 'nbVersions'];
    }
    function slugValide(s) { return s is string && s.size() >= 3 && s.size() <= 100 && s.matches('^[a-z0-9]+(-[a-z0-9]+)*$'); }

    match /articles/{id} {
      function cheminVersion(n) { return /databases/$(database)/documents/articles/$(id)/versions/$(string(n)); }

      // Publié : lu par tous (les listes publiques filtrent statut == 'publie'). Brouillons et articles retirés :
      // rédacteurs seulement (un modérateur lit les brouillons des autres sans pouvoir les modifier).
      allow read: if resource.data.statut == 'publie' || niveau() >= 2;

      // Créer : un brouillon jamais publié, sans adresse, signé du nom du compte.
      allow create: if niveau() >= 2
        && monNom().size() > 0
        // Comparaison d'ensembles : hasOnly + hasAll sur 21 clés dépassait la limite de 1 000 expressions
        // évaluées par requête (test du 24 nov.).
        && request.resource.data.keys().toSet() == champsArticle().toSet()
        && contenuArticleValide(request.resource.data)
        && request.resource.data.statut == 'brouillon'
        && request.resource.data.slug == null
        && request.resource.data.auteurUid == moi()
        && request.resource.data.auteurNom == monNom()
        && request.resource.data.creeLe == request.time
        && request.resource.data.modifieLe == request.time
        && request.resource.data.publieLe == null
        && request.resource.data.republieLe == null
        && request.resource.data.nbVersions == 0;

      // Compteur de versions : inchangé, ou + 1 avec versions/{n} écrit dans le même lot.
      function versionAjoutee() {
        return request.resource.data.nbVersions == resource.data.nbVersions + 1
          && existsAfter(cheminVersion(request.resource.data.nbVersions));
      }
      // Brouillon jamais publié : titre, famille… gardés à jour pour la liste des rédacteurs.
      function editionBrouillon() {
        return proprioArticle(resource.data)
          && resource.data.statut == 'brouillon' && request.resource.data.statut == 'brouillon'
          && changes(['titre', 'famille', 'libelles', 'resume', 'image', 'corps', 'versets', 'sourates', 'racines',
                      'lexique', 'sources', 'liens', 'modifieLe', 'nbVersions'])
          && contenuArticleValide(request.resource.data)
          && request.resource.data.modifieLe == request.time
          && (request.resource.data.nbVersions == resource.data.nbVersions || versionAjoutee());
      }
      // « Enregistrer une version » d'un article publié ou retiré : seul le compteur change.
      function versionSeule() {
        return proprioArticle(resource.data) && resource.data.statut != 'brouillon'
          && changes(['nbVersions']) && versionAjoutee();
      }
      // Toute publication : contenu valide, titre obligatoire, version « publiée » enregistrée dans le lot.
      function publicationCommune() {
        return proprioArticle(resource.data)
          && request.resource.data.statut == 'publie'
          && contenuArticleValide(request.resource.data)
          && request.resource.data.titre.size() >= 1
          && request.resource.data.modifieLe == request.time
          && versionAjoutee()
          && getAfter(cheminVersion(request.resource.data.nbVersions)).data.publiee == true;
      }
      // Première publication : l'adresse est fixée et réservée (slugs/{slug}) dans le même lot.
      function premierePublication() {
        return resource.data.slug == null
          && changes(['titre', 'famille', 'libelles', 'resume', 'image', 'corps', 'versets', 'sourates', 'racines',
                      'lexique', 'sources', 'liens', 'statut', 'slug', 'modifieLe', 'publieLe', 'nbVersions'])
          && publicationCommune()
          && slugValide(request.resource.data.slug)
          && request.resource.data.publieLe == request.time
          && getAfter(/databases/$(database)/documents/slugs/$(request.resource.data.slug)).data.article == id;
      }
      // « Publier les modifications », ou republier un article retiré : l'adresse ne change plus.
      function republication() {
        return resource.data.slug != null
          && changes(['titre', 'famille', 'libelles', 'resume', 'image', 'corps', 'versets', 'sourates', 'racines',
                      'lexique', 'sources', 'liens', 'statut', 'modifieLe', 'republieLe', 'nbVersions'])
          && publicationCommune()
          && request.resource.data.republieLe == request.time;
      }
      // Retirer : l'article n'est plus lu que par les rédacteurs ; ses commentaires restent.
      function retrait() {
        return proprioArticle(resource.data) && resource.data.statut == 'publie'
          && changes(['statut', 'modifieLe'])
          && request.resource.data.statut == 'retire'
          && request.resource.data.modifieLe == request.time;
      }

      // « resource != null » d'abord : dans un lot, la règle de modification est aussi évaluée pour un document
      // nouveau ; sans ce garde-fou, chaque condition produit une erreur (pas « faux »), tout est évalué et la limite
      // de 1 000 expressions par requête est atteinte (test du 24 nov.).
      allow update: if resource != null
        && (editionBrouillon() || versionSeule() || premierePublication() || republication() || retrait());

      // Supprimer définitivement : admin seulement (sous-collections d'abord).
      allow delete: if niveau() >= 3;

      function art() { return get(/databases/$(database)/documents/articles/$(id)).data; }
      function artApres() { return getAfter(/databases/$(database)/documents/articles/$(id)).data; }

      // Version de travail (privée) : atelier/brouillon, avec le panneau Contexte.
      match /atelier/{doc} {
        allow read: if niveau() >= 2;
        allow create, update: if doc == 'brouillon'
          && proprioArticle(artApres())
          && request.resource.data.keys().hasOnly(
               ['titre', 'famille', 'libelles', 'resume', 'image', 'corps', 'contexte', 'majLe', 'majPar'])
          && request.resource.data.keys().hasAll(
               ['titre', 'famille', 'libelles', 'resume', 'image', 'corps', 'contexte', 'majLe', 'majPar'])
          && request.resource.data.titre is string && request.resource.data.titre.size() <= 200
          && familleValide(request.resource.data.famille)
          && request.resource.data.libelles is list && request.resource.data.libelles.size() <= 10
          && request.resource.data.resume is string && request.resource.data.resume.size() <= 500
          && (request.resource.data.image == null || (request.resource.data.image is string && request.resource.data.image.size() <= 300))
          && request.resource.data.corps is string && request.resource.data.corps.size() <= 300000
          && request.resource.data.contexte is map
          && request.resource.data.majLe == request.time
          && request.resource.data.majPar == moi();
        allow delete: if niveau() >= 3;
      }

      // Historique : versions/{n} (n = 1, 2, 3…), jamais modifiées ; lues par les rédacteurs.
      match /versions/{n} {
        allow read: if niveau() >= 2;
        allow create: if proprioArticle(art())
          && n == string(artApres().nbVersions)
          && artApres().nbVersions == art().nbVersions + 1
          && request.resource.data.keys().hasOnly(
               ['titre', 'corps', 'resume', 'famille', 'libelles', 'le', 'parUid', 'parNom', 'publiee'])
          && request.resource.data.keys().hasAll(
               ['titre', 'corps', 'resume', 'famille', 'libelles', 'le', 'parUid', 'parNom', 'publiee'])
          && request.resource.data.titre is string && request.resource.data.titre.size() <= 200
          && request.resource.data.corps is string && request.resource.data.corps.size() <= 300000
          && request.resource.data.resume is string && request.resource.data.resume.size() <= 500
          && familleValide(request.resource.data.famille)
          && request.resource.data.libelles is list
          && request.resource.data.le == request.time
          && request.resource.data.parUid == moi()
          && request.resource.data.parNom == monNom()
          && request.resource.data.publiee is bool
          // Une version « publiée » est exactement ce qui est mis en ligne dans le même lot.
          && (request.resource.data.publiee == false
              || (artApres().statut == 'publie'
                  && artApres().modifieLe == request.time
                  && request.resource.data.titre == artApres().titre
                  && request.resource.data.corps == artApres().corps));
        allow delete: if niveau() >= 3;
      }
    }

    // Adresses réservées : slugs/{slug} = { article }, créé à la première publication, jamais modifié.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if niveau() >= 2
        && slugValide(slug)
        && request.resource.data.keys().hasOnly(['article'])
        && request.resource.data.article is string
        && request.resource.data.article.matches('^[A-Za-z0-9_-]{1,64}$')
        && get(/databases/$(database)/documents/articles/$(request.resource.data.article)).data.slug == null
        && proprioArticle(getAfter(/databases/$(database)/documents/articles/$(request.resource.data.article)).data)
        && getAfter(/databases/$(database)/documents/articles/$(request.resource.data.article)).data.slug == slug;
      allow delete: if niveau() >= 3;
    }

    // ---------- Mes Notes et forum (docs/MODELE-DONNEES.md) ----------
    // Une note privée (publie == false) n'est lue que par son auteur ; publiée, c'est un fil du forum lu par tous.
    function lienValide(l) {
      return l == null
        || (l.keys().hasOnly(['type', 'cle']) && l.cle is string
            && ((l.type == 'verset' && l.cle.matches('^[0-9]{1,3}:[0-9]{1,3}$'))
              || ((l.type == 'racine' || l.type == 'lexique') && l.cle.size() >= 1 && l.cle.size() <= 200)
              || (l.type == 'article' && l.cle.matches('^[A-Za-z0-9_-]{1,64}$'))));
    }
    function titreValide(t, requis) { return t is string && t.size() <= 140 && (!requis || t.size() >= 1); }
    function texteNoteValide(t) { return t is string && t.size() >= 1 && t.size() <= 20000; }
    function champsNote() {
      return ['auteurUid', 'auteurNom', 'titre', 'texte', 'lien', 'publie', 'creeLe', 'modifieLe', 'publieLe',
              'activiteLe', 'nbReponses', 'nbReponsesAutrui', 'nbVersions', 'masque'];
    }
    function champsReponse() {
      return ['auteurUid', 'auteurNom', 'texte', 'creeLe', 'modifieLe', 'nbVersions', 'masque'];
    }
    // Signalement : un par membre, jamais sur son propre contenu.
    function signalementValide(auteurDuContenu, uid) {
      return niveau() >= 1 && uid == moi() && auteurDuContenu != moi()
        && request.resource.data.keys().hasOnly(['motif', 'le'])
        && request.resource.data.motif is string && request.resource.data.motif.size() <= 500
        && request.resource.data.le == request.time
        && limiteOk();
    }
    function masqueValide(m) {
      return m.keys().hasOnly(['par', 'parNom', 'le']) && m.par == moi() && m.parNom == monNom() && m.le == request.time;
    }

    match /notes/{id} {
      function note() { return get(/databases/$(database)/documents/notes/$(id)).data; }
      function noteApres() { return getAfter(/databases/$(database)/documents/notes/$(id)).data; }
      function estAuteurNote() { return request.auth != null && note().auteurUid == request.auth.uid; }

      allow read: if resource.data.publie == true
        || (request.auth != null && resource.data.auteurUid == request.auth.uid);

      // Créer une note (privée ou publiée tout de suite).
      allow create: if niveau() >= 1
        && monNom().size() > 0
        && request.resource.data.keys().hasOnly(champsNote())
        && request.resource.data.keys().hasAll(champsNote())
        && request.resource.data.auteurUid == moi()
        && request.resource.data.auteurNom == monNom()
        && request.resource.data.publie is bool
        && titreValide(request.resource.data.titre, request.resource.data.publie)
        && texteNoteValide(request.resource.data.texte)
        && lienValide(request.resource.data.lien)
        && request.resource.data.creeLe == request.time
        && request.resource.data.modifieLe == request.time
        && request.resource.data.activiteLe == request.time
        && request.resource.data.publieLe == (request.resource.data.publie ? request.time : null)
        && request.resource.data.nbReponses == 0
        && request.resource.data.nbReponsesAutrui == 0
        && request.resource.data.nbVersions == 1
        && request.resource.data.masque == null
        && limiteOk();

      function parAuteur() {
        return niveau() >= 1 && resource.data.auteurUid == moi() && resource.data.masque == null;
      }
      function contenuValide() {
        return titreValide(request.resource.data.titre, request.resource.data.publie == true)
          && texteNoteValide(request.resource.data.texte)
          && lienValide(request.resource.data.lien);
      }
      // Note privée : modification libre, sans historique.
      function editionPrivee() {
        return parAuteur() && resource.data.publie == false && request.resource.data.publie == false
          && changes(['titre', 'texte', 'lien', 'modifieLe'])
          && contenuValide() && request.resource.data.modifieLe == request.time;
      }
      // Publier : la note devient un fil (titre obligatoire).
      function publication() {
        return parAuteur() && resource.data.publie == false && request.resource.data.publie == true
          && changes(['titre', 'texte', 'lien', 'modifieLe', 'publie', 'publieLe', 'activiteLe'])
          && contenuValide()
          && request.resource.data.modifieLe == request.time
          && request.resource.data.publieLe == request.time
          && request.resource.data.activiteLe == request.time;
      }
      // Fil publié : modification avec historique (versions/{n} écrit dans le même lot).
      function editionPubliee() {
        return parAuteur() && resource.data.publie == true && request.resource.data.publie == true
          && changes(['titre', 'texte', 'lien', 'modifieLe', 'nbVersions'])
          && contenuValide()
          && request.resource.data.modifieLe == request.time
          && request.resource.data.nbVersions == resource.data.nbVersions + 1
          && existsAfter(/databases/$(database)/documents/notes/$(id)/versions/$(string(resource.data.nbVersions)));
      }
      // Dépublier : seulement si aucun autre membre n'a répondu.
      function depublication() {
        return parAuteur() && resource.data.publie == true && request.resource.data.publie == false
          && resource.data.nbReponsesAutrui == 0
          && changes(['publie', 'publieLe'])
          && request.resource.data.publieLe == null;
      }
      // Nouvelle réponse : compteurs et activité mis à jour dans le même lot que reponses/{n+1}.
      function compteurReponse() {
        return niveau() >= 1 && resource.data.publie == true && resource.data.masque == null
          && changes(['nbReponses', 'nbReponsesAutrui', 'activiteLe'])
          && request.resource.data.nbReponses == resource.data.nbReponses + 1
          && request.resource.data.nbReponsesAutrui == resource.data.nbReponsesAutrui + (resource.data.auteurUid == moi() ? 0 : 1)
          && request.resource.data.activiteLe == request.time
          && existsAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(string(resource.data.nbReponses + 1)));
      }
      // Masquer un fil (niveau ≥ 2) : titre et texte mis à part dans prive/texte.
      function masquageNote() {
        return niveau() >= 2 && resource.data.publie == true && resource.data.masque == null
          && changes(['masque', 'titre', 'texte'])
          && request.resource.data.titre == '' && request.resource.data.texte == ''
          && masqueValide(request.resource.data.masque)
          && getAfter(/databases/$(database)/documents/notes/$(id)/prive/texte).data.titre == resource.data.titre
          && getAfter(/databases/$(database)/documents/notes/$(id)/prive/texte).data.texte == resource.data.texte;
      }
      function demasquageNote() {
        return niveau() >= 2 && resource.data.masque != null
          && changes(['masque', 'titre', 'texte'])
          && request.resource.data.masque == null
          && request.resource.data.titre == get(/databases/$(database)/documents/notes/$(id)/prive/texte).data.titre
          && request.resource.data.texte == get(/databases/$(database)/documents/notes/$(id)/prive/texte).data.texte
          && !existsAfter(/databases/$(database)/documents/notes/$(id)/prive/texte);
      }

      allow update: if editionPrivee() || publication() || editionPubliee() || depublication()
        || compteurReponse() || masquageNote() || demasquageNote();

      // Supprimer : l'auteur, tant que la note est privée ; l'admin, toujours.
      allow delete: if (niveau() >= 1 && resource.data.auteurUid == moi() && resource.data.publie == false)
        || niveau() >= 3;

      match /versions/{n} {
        allow read: if (note().publie == true && note().masque == null) || estAuteurNote() || niveau() >= 2;
        allow create: if niveau() >= 1
          && note().auteurUid == moi() && note().publie == true && note().masque == null
          && n == string(note().nbVersions)
          && noteApres().nbVersions == note().nbVersions + 1
          && request.resource.data.keys().hasOnly(['titre', 'texte', 'lien', 'le'])
          && request.resource.data.titre == note().titre
          && request.resource.data.texte == note().texte
          && request.resource.data.lien == note().lien
          && request.resource.data.le == note().modifieLe;
        allow delete: if niveau() >= 3 || (estAuteurNote() && note().publie == false);
      }

      match /prive/{doc} {
        allow read: if niveau() >= 2;
        allow create: if niveau() >= 2 && doc == 'texte'
          && note().masque == null && noteApres().masque != null
          && request.resource.data.keys().hasOnly(['titre', 'texte'])
          && request.resource.data.titre == note().titre
          && request.resource.data.texte == note().texte;
        allow delete: if (niveau() >= 2 && doc == 'texte' && noteApres().masque == null) || niveau() >= 3;
      }

      match /signalements/{uid} {
        allow read: if niveau() >= 2;
        allow create: if note().publie == true && signalementValide(note().auteurUid, uid);
        allow delete: if niveau() >= 2;
      }

      // ---------- Réponses d'un fil : reponses/{n}, n = 1, 2, 3… ----------
      match /reponses/{rid} {
        function rep() { return get(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)).data; }
        function repApres() { return getAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)).data; }

        allow read: if note().publie == true || estAuteurNote() || niveau() >= 2;

        allow create: if niveau() >= 1
          && monNom().size() > 0
          && note().publie == true && note().masque == null
          && rid == string(note().nbReponses + 1)
          && noteApres().nbReponses == note().nbReponses + 1
          && request.resource.data.keys().hasOnly(champsReponse())
          && request.resource.data.keys().hasAll(champsReponse())
          && request.resource.data.auteurUid == moi()
          && request.resource.data.auteurNom == monNom()
          && texteValide(request.resource.data.texte)
          && request.resource.data.creeLe == request.time
          && request.resource.data.modifieLe == null
          && request.resource.data.nbVersions == 1
          && request.resource.data.masque == null
          && limiteOk();

        function editionReponse() {
          return niveau() >= 1 && resource.data.auteurUid == moi() && resource.data.masque == null
            && changes(['texte', 'modifieLe', 'nbVersions'])
            && texteValide(request.resource.data.texte)
            && request.resource.data.modifieLe == request.time
            && request.resource.data.nbVersions == resource.data.nbVersions + 1
            && existsAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/versions/$(string(resource.data.nbVersions)));
        }
        function masquageReponse() {
          return niveau() >= 2 && resource.data.masque == null
            && changes(['masque', 'texte'])
            && request.resource.data.texte == ''
            && masqueValide(request.resource.data.masque)
            && getAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/prive/texte).data.texte == resource.data.texte;
        }
        function demasquageReponse() {
          return niveau() >= 2 && resource.data.masque != null
            && changes(['masque', 'texte'])
            && request.resource.data.masque == null
            && request.resource.data.texte == get(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/prive/texte).data.texte
            && !existsAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/prive/texte);
        }
        allow update: if editionReponse() || masquageReponse() || demasquageReponse();

        allow delete: if niveau() >= 3
          || (estAuteurNote() && note().publie == false && resource.data.auteurUid == moi());

        match /versions/{n} {
          allow read: if (note().publie == true || estAuteurNote()) && (rep().masque == null || niveau() >= 2);
          allow create: if niveau() >= 1
            && rep().auteurUid == moi() && rep().masque == null
            && n == string(rep().nbVersions)
            && repApres().nbVersions == rep().nbVersions + 1
            && request.resource.data.keys().hasOnly(['texte', 'le'])
            && request.resource.data.texte == rep().texte
            && request.resource.data.le == (rep().modifieLe != null ? rep().modifieLe : rep().creeLe);
          allow delete: if niveau() >= 3 || (estAuteurNote() && note().publie == false);
        }
        match /prive/{doc} {
          allow read: if niveau() >= 2;
          allow create: if niveau() >= 2 && doc == 'texte'
            && rep().masque == null && repApres().masque != null
            && request.resource.data.keys().hasOnly(['texte'])
            && request.resource.data.texte == rep().texte;
          allow delete: if (niveau() >= 2 && doc == 'texte' && repApres().masque == null) || niveau() >= 3;
        }
        match /signalements/{uid} {
          allow read: if niveau() >= 2;
          allow create: if signalementValide(rep().auteurUid, uid);
          allow delete: if niveau() >= 2;
        }
      }
    }
  }
}
