rules_version = '2';

// Tout est fermé par défaut ; chaque collection est ouverte explicitement et testée
// avec l'émulateur (tests/regles/). Droits : docs/DROITS.md ; modèle : docs/MODELE-DONNEES.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Niveaux (docs/DROITS.md) ----------
    // 0 = visiteur ou courriel non vérifié ; 1 = inscrit vérifié (par défaut) ;
    // 2 = modérateur, 3 = admin : revendication « niveau » posée côté serveur, jamais par le client.
    function niveau() {
      return request.auth == null || request.auth.token.email_verified != true
        ? 0
        : request.auth.token.get('niveau', 1);
    }
    function moi() { return request.auth.uid; }
    // Le nom affiché vient du compte (jeton), pas du formulaire.
    function monNom() { return request.auth.token.get('name', ''); }

    function texteValide(t) { return t is string && t.size() >= 1 && t.size() <= 4000; }
    function cibleValide(d) {
      return (d.type == 'verset' && d.cle is string && d.cle.matches('^[0-9]{1,3}:[0-9]{1,3}$'))
        || (d.type == 'lexique' && d.cle is string && d.cle.size() >= 1 && d.cle.size() <= 200);
    }
    function changes(cles) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(cles);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Limite de fréquence (docs/DROITS.md) ----------
    // 20 publications par heure et par membre (commentaires, notes, réponses, signalements) ;
    // modérateurs et admin exemptés. Chaque publication met à jour limites/{uid} dans le même lot.
    function limiteOk() {
      return niveau() >= 2
        || getAfter(/databases/$(database)/documents/limites/$(request.auth.uid)).data.dernier == request.time;
    }
    match /limites/{uid} {
      function nouvelleFenetre() {
        return request.resource.data.keys().hasOnly(['debut', 'n', 'dernier'])
          && request.resource.data.debut == request.time
          && request.resource.data.n == 1
          && request.resource.data.dernier == request.time;
      }
      function memeFenetre() {
        return request.resource.data.keys().hasOnly(['debut', 'n', 'dernier'])
          && resource.data.debut > request.time - duration.value(1, 'h')
          && request.resource.data.debut == resource.data.debut
          && request.resource.data.n == resource.data.n + 1
          && request.resource.data.n <= 20
          && request.resource.data.dernier == request.time;
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if niveau() >= 1 && uid == moi() && nouvelleFenetre();
      allow update: if niveau() >= 1 && uid == moi()
        && ((resource.data.debut <= request.time - duration.value(1, 'h') && nouvelleFenetre()) || memeFenetre());
    }

    // ---------- Commentaires Alfamous (versets et lexique) ----------
    match /commentaires/{id} {
      // Lecture publique. Un commentaire masqué a un texte vide : l'original est dans prive/texte.
      allow read: if true;

      // Écrire : niveau ≥ 1, publié tout de suite, signé du nom du compte.
      allow create: if niveau() >= 1
        && monNom().size() > 0
        && request.resource.data.keys().hasOnly(
             ['type', 'cle', 'auteurUid', 'auteurNom', 'texte', 'creeLe', 'modifieLe', 'nbVersions', 'masque'])
        && request.resource.data.keys().hasAll(
             ['type', 'cle', 'auteurUid', 'auteurNom', 'texte', 'creeLe', 'modifieLe', 'nbVersions', 'masque'])
        && cibleValide(request.resource.data)
        && request.resource.data.auteurUid == moi()
        && request.resource.data.auteurNom == monNom()
        && texteValide(request.resource.data.texte)
        && request.resource.data.creeLe == request.time
        && request.resource.data.modifieLe == null
        && request.resource.data.nbVersions == 1
        && request.resource.data.masque == null
        && limiteOk();

      // Modifier son commentaire (s'il n'est pas masqué) ; l'ancienne version est écrite
      // dans le même lot (versions/{n}), sinon refus.
      function modificationParAuteur() {
        return niveau() >= 1
          && resource.data.auteurUid == moi()
          && resource.data.masque == null
          && changes(['texte', 'modifieLe', 'nbVersions'])
          && texteValide(request.resource.data.texte)
          && request.resource.data.modifieLe == request.time
          && request.resource.data.nbVersions == resource.data.nbVersions + 1
          && existsAfter(/databases/$(database)/documents/commentaires/$(id)/versions/$(string(resource.data.nbVersions)));
      }
      // Masquer (niveau ≥ 2) : texte vidé, original déplacé dans prive/texte dans le même lot.
      function masquage() {
        return niveau() >= 2
          && resource.data.masque == null
          && changes(['masque', 'texte'])
          && request.resource.data.texte == ''
          && request.resource.data.masque.keys().hasOnly(['par', 'parNom', 'le'])
          && request.resource.data.masque.par == moi()
          && request.resource.data.masque.parNom == monNom()
          && request.resource.data.masque.le == request.time
          && getAfter(/databases/$(database)/documents/commentaires/$(id)/prive/texte).data.texte == resource.data.texte;
      }
      // Démasquer (niveau ≥ 2) : texte remis tel quel, prive/texte supprimé dans le même lot.
      function demasquage() {
        return niveau() >= 2
          && resource.data.masque != null
          && changes(['masque', 'texte'])
          && request.resource.data.masque == null
          && request.resource.data.texte == get(/databases/$(database)/documents/commentaires/$(id)/prive/texte).data.texte
          && !existsAfter(/databases/$(database)/documents/commentaires/$(id)/prive/texte);
      }

      allow update: if modificationParAuteur() || masquage() || demasquage();

      // Supprimer définitivement : admin seulement (l'auteur ne supprime pas son contenu publié).
      allow delete: if niveau() >= 3;

      function com() { return get(/databases/$(database)/documents/commentaires/$(id)).data; }
      function comApres() { return getAfter(/databases/$(database)/documents/commentaires/$(id)).data; }

      // Historique : versions/{n} = texte de la version n (1 = première), jamais modifié.
      match /versions/{n} {
        allow read: if com().masque == null || niveau() >= 2;
        allow create: if niveau() >= 1
          && com().auteurUid == moi()
          && com().masque == null
          && n == string(com().nbVersions)
          && comApres().nbVersions == com().nbVersions + 1
          && request.resource.data.keys().hasOnly(['texte', 'le'])
          && request.resource.data.texte == com().texte
          && request.resource.data.le == (com().modifieLe != null ? com().modifieLe : com().creeLe);
        allow delete: if niveau() >= 3;
      }

      // Texte d'un commentaire masqué : modérateurs et admin seulement.
      match /prive/{doc} {
        allow read: if niveau() >= 2;
        allow create: if niveau() >= 2
          && doc == 'texte'
          && com().masque == null
          && comApres().masque != null
          && request.resource.data.keys().hasOnly(['texte'])
          && request.resource.data.texte == com().texte;
        allow delete: if (niveau() >= 2 && doc == 'texte' && comApres().masque == null)
          || niveau() >= 3;
      }

      // Signalements : un par membre et par commentaire ; lus par les modérateurs.
      match /signalements/{uid} {
        allow read: if niveau() >= 2;
        allow create: if niveau() >= 1
          && uid == moi()
          && com().auteurUid != moi()
          && request.resource.data.keys().hasOnly(['motif', 'le'])
          && request.resource.data.motif is string
          && request.resource.data.motif.size() <= 500
          && request.resource.data.le == request.time
          && limiteOk();
        allow delete: if niveau() >= 2;
      }
    }

    // ---------- Mes Notes et forum (docs/MODELE-DONNEES.md) ----------
    // Une note privée (publie == false) n'est lue que par son auteur ; publiée, c'est un fil du forum lu par tous.
    function lienValide(l) {
      return l == null
        || (l.keys().hasOnly(['type', 'cle']) && l.cle is string
            && ((l.type == 'verset' && l.cle.matches('^[0-9]{1,3}:[0-9]{1,3}$'))
              || ((l.type == 'racine' || l.type == 'lexique') && l.cle.size() >= 1 && l.cle.size() <= 200)));
    }
    function titreValide(t, requis) { return t is string && t.size() <= 140 && (!requis || t.size() >= 1); }
    function texteNoteValide(t) { return t is string && t.size() >= 1 && t.size() <= 20000; }
    function champsNote() {
      return ['auteurUid', 'auteurNom', 'titre', 'texte', 'lien', 'publie', 'creeLe', 'modifieLe', 'publieLe',
              'activiteLe', 'nbReponses', 'nbReponsesAutrui', 'nbVersions', 'masque'];
    }
    function champsReponse() {
      return ['auteurUid', 'auteurNom', 'texte', 'creeLe', 'modifieLe', 'nbVersions', 'masque'];
    }
    // Signalement : un par membre, jamais sur son propre contenu.
    function signalementValide(auteurDuContenu, uid) {
      return niveau() >= 1 && uid == moi() && auteurDuContenu != moi()
        && request.resource.data.keys().hasOnly(['motif', 'le'])
        && request.resource.data.motif is string && request.resource.data.motif.size() <= 500
        && request.resource.data.le == request.time
        && limiteOk();
    }
    function masqueValide(m) {
      return m.keys().hasOnly(['par', 'parNom', 'le']) && m.par == moi() && m.parNom == monNom() && m.le == request.time;
    }

    match /notes/{id} {
      function note() { return get(/databases/$(database)/documents/notes/$(id)).data; }
      function noteApres() { return getAfter(/databases/$(database)/documents/notes/$(id)).data; }
      function estAuteurNote() { return request.auth != null && note().auteurUid == request.auth.uid; }

      allow read: if resource.data.publie == true
        || (request.auth != null && resource.data.auteurUid == request.auth.uid);

      // Créer une note (privée ou publiée tout de suite).
      allow create: if niveau() >= 1
        && monNom().size() > 0
        && request.resource.data.keys().hasOnly(champsNote())
        && request.resource.data.keys().hasAll(champsNote())
        && request.resource.data.auteurUid == moi()
        && request.resource.data.auteurNom == monNom()
        && request.resource.data.publie is bool
        && titreValide(request.resource.data.titre, request.resource.data.publie)
        && texteNoteValide(request.resource.data.texte)
        && lienValide(request.resource.data.lien)
        && request.resource.data.creeLe == request.time
        && request.resource.data.modifieLe == request.time
        && request.resource.data.activiteLe == request.time
        && request.resource.data.publieLe == (request.resource.data.publie ? request.time : null)
        && request.resource.data.nbReponses == 0
        && request.resource.data.nbReponsesAutrui == 0
        && request.resource.data.nbVersions == 1
        && request.resource.data.masque == null
        && limiteOk();

      function parAuteur() {
        return niveau() >= 1 && resource.data.auteurUid == moi() && resource.data.masque == null;
      }
      function contenuValide() {
        return titreValide(request.resource.data.titre, request.resource.data.publie == true)
          && texteNoteValide(request.resource.data.texte)
          && lienValide(request.resource.data.lien);
      }
      // Note privée : modification libre, sans historique.
      function editionPrivee() {
        return parAuteur() && resource.data.publie == false && request.resource.data.publie == false
          && changes(['titre', 'texte', 'lien', 'modifieLe'])
          && contenuValide() && request.resource.data.modifieLe == request.time;
      }
      // Publier : la note devient un fil (titre obligatoire).
      function publication() {
        return parAuteur() && resource.data.publie == false && request.resource.data.publie == true
          && changes(['titre', 'texte', 'lien', 'modifieLe', 'publie', 'publieLe', 'activiteLe'])
          && contenuValide()
          && request.resource.data.modifieLe == request.time
          && request.resource.data.publieLe == request.time
          && request.resource.data.activiteLe == request.time;
      }
      // Fil publié : modification avec historique (versions/{n} écrit dans le même lot).
      function editionPubliee() {
        return parAuteur() && resource.data.publie == true && request.resource.data.publie == true
          && changes(['titre', 'texte', 'lien', 'modifieLe', 'nbVersions'])
          && contenuValide()
          && request.resource.data.modifieLe == request.time
          && request.resource.data.nbVersions == resource.data.nbVersions + 1
          && existsAfter(/databases/$(database)/documents/notes/$(id)/versions/$(string(resource.data.nbVersions)));
      }
      // Dépublier : seulement si aucun autre membre n'a répondu.
      function depublication() {
        return parAuteur() && resource.data.publie == true && request.resource.data.publie == false
          && resource.data.nbReponsesAutrui == 0
          && changes(['publie', 'publieLe'])
          && request.resource.data.publieLe == null;
      }
      // Nouvelle réponse : compteurs et activité mis à jour dans le même lot que reponses/{n+1}.
      function compteurReponse() {
        return niveau() >= 1 && resource.data.publie == true && resource.data.masque == null
          && changes(['nbReponses', 'nbReponsesAutrui', 'activiteLe'])
          && request.resource.data.nbReponses == resource.data.nbReponses + 1
          && request.resource.data.nbReponsesAutrui == resource.data.nbReponsesAutrui + (resource.data.auteurUid == moi() ? 0 : 1)
          && request.resource.data.activiteLe == request.time
          && existsAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(string(resource.data.nbReponses + 1)));
      }
      // Masquer un fil (niveau ≥ 2) : titre et texte mis à part dans prive/texte.
      function masquageNote() {
        return niveau() >= 2 && resource.data.publie == true && resource.data.masque == null
          && changes(['masque', 'titre', 'texte'])
          && request.resource.data.titre == '' && request.resource.data.texte == ''
          && masqueValide(request.resource.data.masque)
          && getAfter(/databases/$(database)/documents/notes/$(id)/prive/texte).data.titre == resource.data.titre
          && getAfter(/databases/$(database)/documents/notes/$(id)/prive/texte).data.texte == resource.data.texte;
      }
      function demasquageNote() {
        return niveau() >= 2 && resource.data.masque != null
          && changes(['masque', 'titre', 'texte'])
          && request.resource.data.masque == null
          && request.resource.data.titre == get(/databases/$(database)/documents/notes/$(id)/prive/texte).data.titre
          && request.resource.data.texte == get(/databases/$(database)/documents/notes/$(id)/prive/texte).data.texte
          && !existsAfter(/databases/$(database)/documents/notes/$(id)/prive/texte);
      }

      allow update: if editionPrivee() || publication() || editionPubliee() || depublication()
        || compteurReponse() || masquageNote() || demasquageNote();

      // Supprimer : l'auteur, tant que la note est privée ; l'admin, toujours.
      allow delete: if (niveau() >= 1 && resource.data.auteurUid == moi() && resource.data.publie == false)
        || niveau() >= 3;

      match /versions/{n} {
        allow read: if (note().publie == true && note().masque == null) || estAuteurNote() || niveau() >= 2;
        allow create: if niveau() >= 1
          && note().auteurUid == moi() && note().publie == true && note().masque == null
          && n == string(note().nbVersions)
          && noteApres().nbVersions == note().nbVersions + 1
          && request.resource.data.keys().hasOnly(['titre', 'texte', 'lien', 'le'])
          && request.resource.data.titre == note().titre
          && request.resource.data.texte == note().texte
          && request.resource.data.lien == note().lien
          && request.resource.data.le == note().modifieLe;
        allow delete: if niveau() >= 3 || (estAuteurNote() && note().publie == false);
      }

      match /prive/{doc} {
        allow read: if niveau() >= 2;
        allow create: if niveau() >= 2 && doc == 'texte'
          && note().masque == null && noteApres().masque != null
          && request.resource.data.keys().hasOnly(['titre', 'texte'])
          && request.resource.data.titre == note().titre
          && request.resource.data.texte == note().texte;
        allow delete: if (niveau() >= 2 && doc == 'texte' && noteApres().masque == null) || niveau() >= 3;
      }

      match /signalements/{uid} {
        allow read: if niveau() >= 2;
        allow create: if note().publie == true && signalementValide(note().auteurUid, uid);
        allow delete: if niveau() >= 2;
      }

      // ---------- Réponses d'un fil : reponses/{n}, n = 1, 2, 3… ----------
      match /reponses/{rid} {
        function rep() { return get(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)).data; }
        function repApres() { return getAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)).data; }

        allow read: if note().publie == true || estAuteurNote() || niveau() >= 2;

        allow create: if niveau() >= 1
          && monNom().size() > 0
          && note().publie == true && note().masque == null
          && rid == string(note().nbReponses + 1)
          && noteApres().nbReponses == note().nbReponses + 1
          && request.resource.data.keys().hasOnly(champsReponse())
          && request.resource.data.keys().hasAll(champsReponse())
          && request.resource.data.auteurUid == moi()
          && request.resource.data.auteurNom == monNom()
          && texteValide(request.resource.data.texte)
          && request.resource.data.creeLe == request.time
          && request.resource.data.modifieLe == null
          && request.resource.data.nbVersions == 1
          && request.resource.data.masque == null
          && limiteOk();

        function editionReponse() {
          return niveau() >= 1 && resource.data.auteurUid == moi() && resource.data.masque == null
            && changes(['texte', 'modifieLe', 'nbVersions'])
            && texteValide(request.resource.data.texte)
            && request.resource.data.modifieLe == request.time
            && request.resource.data.nbVersions == resource.data.nbVersions + 1
            && existsAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/versions/$(string(resource.data.nbVersions)));
        }
        function masquageReponse() {
          return niveau() >= 2 && resource.data.masque == null
            && changes(['masque', 'texte'])
            && request.resource.data.texte == ''
            && masqueValide(request.resource.data.masque)
            && getAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/prive/texte).data.texte == resource.data.texte;
        }
        function demasquageReponse() {
          return niveau() >= 2 && resource.data.masque != null
            && changes(['masque', 'texte'])
            && request.resource.data.masque == null
            && request.resource.data.texte == get(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/prive/texte).data.texte
            && !existsAfter(/databases/$(database)/documents/notes/$(id)/reponses/$(rid)/prive/texte);
        }
        allow update: if editionReponse() || masquageReponse() || demasquageReponse();

        allow delete: if niveau() >= 3
          || (estAuteurNote() && note().publie == false && resource.data.auteurUid == moi());

        match /versions/{n} {
          allow read: if (note().publie == true || estAuteurNote()) && (rep().masque == null || niveau() >= 2);
          allow create: if niveau() >= 1
            && rep().auteurUid == moi() && rep().masque == null
            && n == string(rep().nbVersions)
            && repApres().nbVersions == rep().nbVersions + 1
            && request.resource.data.keys().hasOnly(['texte', 'le'])
            && request.resource.data.texte == rep().texte
            && request.resource.data.le == (rep().modifieLe != null ? rep().modifieLe : rep().creeLe);
          allow delete: if niveau() >= 3 || (estAuteurNote() && note().publie == false);
        }
        match /prive/{doc} {
          allow read: if niveau() >= 2;
          allow create: if niveau() >= 2 && doc == 'texte'
            && rep().masque == null && repApres().masque != null
            && request.resource.data.keys().hasOnly(['texte'])
            && request.resource.data.texte == rep().texte;
          allow delete: if (niveau() >= 2 && doc == 'texte' && repApres().masque == null) || niveau() >= 3;
        }
        match /signalements/{uid} {
          allow read: if niveau() >= 2;
          allow create: if signalementValide(rep().auteurUid, uid);
          allow delete: if niveau() >= 2;
        }
      }
    }
  }
}
